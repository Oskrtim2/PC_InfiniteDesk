{
  "name": "infinitedesk",
  "version": "1.0.0",
  "description": "Infinite Desktop Workspace Manager for Windows 11 — Navigate through unlimited virtual desktop zones",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "postinstall": "electron-builder install-app-deps",
    "sync": "git add . && git commit -m \"Auto update\" && git push"
  },
  "author": {
    "name": "InfiniteDesk",
    "email": "contact@infinitedesk.app"
  },
  "license": "MIT",
  "dependencies": {
    "systeminformation": "^5.22.0",
    "electron-log": "^5.1.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "extends": null
  }
}
